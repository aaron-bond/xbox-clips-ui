# Local UI development uses the production API, which allows http://localhost:5173.
# Every lookup spends the shared upstream budget (150/hour), so test sparingly.
# To use a local API instead, set VITE_API_BASE_URL=http://localhost:8787 in .env.local.
VITE_API_BASE_URL=https://xbox-clips-api.xbox-clips-api.workers.dev
